rules_version = '2';

// DocuSalud — Firestore Security Rules
// Task 3.1.2 in DOCUSALUD_DEV_GUIDE_v1.1.md.
// Ships together with Task 3.1.1 (Firebase Auth in client) — deploying these
// rules without the auth rebuild would break the live site (every read/write
// would return permission-denied).
//
// Current scope: any authenticated user can read and write any patient.
// This is appropriate for the current single-tenant deployment (one clinic
// per Firebase project). Per-clinic / per-doctor scoping waits on Decision B
// (auth model) to resolve — see Part 2 of the dev guide.

service cloud.firestore {
  match /databases/{database}/documents {

    match /pacientes/{patientId} {
      allow read, write: if request.auth != null;
    }

    // Default deny for any other path. Explicit so future collections need an
    // explicit decision rather than inheriting access by accident.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
